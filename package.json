{
  "name": "dmarczero",
  "version": "1.0.0",
  "description": "Zero-dependency Node.js 24 DNS / DMARC / SSL anti-drift guard and streaming RUA analyzer by ApexHive Labs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dmarczero": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "author": "ApexHive Labs <apexhive.hq@proton.me>",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "^5.8.2"
  }
}
